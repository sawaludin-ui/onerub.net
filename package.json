{
  "name": "onerub-net",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/build-release-manifest.mjs",
    "build": "next build",
    "release:manifest": "node scripts/build-release-manifest.mjs",
    "test:prepare": "node scripts/prepare-tests.mjs",
    "pretest": "npm run test:prepare",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --experimental-test-module-mocks --test tests/*.test.mjs",
    "compile": "node scripts/compile.mjs",
    "deploy:contract": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.9.0",
    "@vercel/oidc": "4.0.9",
    "ethers": "6.17.0",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "onerub-test-chain": "file:scripts/test-chain",
    "solc": "0.8.39"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    },
    "@vercel/oidc": "$@vercel/oidc"
  }
}
