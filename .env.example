# Never put wallet private keys or sessions in the web application.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Generate securely; keep stable and backed up across deployments.
MARKETPLACE_ENCRYPTION_KEY=
MARKETPLACE_AUTH_SECRET=
# Independent, versioned decision MAC; never reuse the challenge secret.
MARKETPLACE_DECISION_KEY_ID=
MARKETPLACE_DECISION_KEY=
MARKETPLACE_DECISION_KEYS_JSON={}
# Explicit bounded legacy verification only when preserving saved decisions:
MARKETPLACE_DECISION_LEGACY_KEY=
MARKETPLACE_DECISION_LEGACY_VERIFY_UNTIL=
# Decryption key IDs retain access to accepted historical artifacts.
MARKETPLACE_ENCRYPTION_KEY_VERSION=v1
MARKETPLACE_ENCRYPTION_KEYRING={}
# Receipt signer is not a participant wallet key. Server-only; never NEXT_PUBLIC.
MARKETPLACE_ATTESTATION_KEY=
MARKETPLACE_ATTESTATION_KEYS_JSON={}
# Recovery uses a separately protected backup key file, not a web deployment secret.
MARKETPLACE_BACKUP_KEY_FILE=
MARKETPLACE_EVALUATOR_ENABLED=false
# Defaults when enabled: Vercel AI Gateway via automatic VERCEL_OIDC_TOKEN.
# Optional HTTPS OpenAI-compatible endpoint/key/model override:
MARKETPLACE_EVALUATOR_URL=
MARKETPLACE_EVALUATOR_KEY=
MARKETPLACE_EVALUATOR_MODEL=google/gemini-2.5-flash-lite
