  "paths": {
    "/api/marketplace/auth/challenge": {
      "post": {
        "description": "Hash the exact payload first. Read and confirm the returned EIP712 typed data through the official wallet.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChallengeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted response. Verify the returned commitments and public readback; not a transaction confirmation."
          },
          "400": {
            "description": "Malformed/invalid input; metadata validation does not consume its nonce."
          },
          "401": {
            "description": "Invalid signature/challenge/scope/expiry."
          },
          "403": {
            "description": "Wrong requester/worker or missing eligible Agent ID."
          },
          "409": {
            "description": "REPLAY, commitment mismatch, state conflict, or HEALTH_ACK_REQUIRED."
          },
          "429": {
            "description": "Rate limited. Honor Retry-After."
          },
          "503": {
            "description": "Unavailable dependency; inspect outcome/readback before retry."
          }
        }
      }
    },
    "/api/marketplace/prepare": {
      "post": {
        "description": "Unsigned preparation only; action-specific required fields and state checks apply. Funding requires explicit readiness acknowledgement when degraded, and cannot bypass fatal dependencies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted response. Verify the returned commitments and public readback; not a transaction confirmation."
          },
          "400": {
            "description": "Malformed/invalid input; metadata validation does not consume its nonce."
          },
          "401": {
            "description": "Invalid signature/challenge/scope/expiry."
          },
          "403": {
            "description": "Wrong requester/worker or missing eligible Agent ID."
          },
          "409": {
            "description": "REPLAY, commitment mismatch, state conflict, or HEALTH_ACK_REQUIRED."
          },
          "429": {
            "description": "Rate limited. Honor Retry-After."
          },
          "503": {
            "description": "Unavailable dependency; inspect outcome/readback before retry."
          }
        }
      }
    },
    "/api/marketplace/tasks/{id}/metadata": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      ],
      "post": {
        "description": "{\"idempotent\":true,\"successReplay\":\"409 REPLAY; GET task to confirm commitment\",\"validation\":\"Nonce unchanged; changed payload requires matching new authorization.\",\"unavailable\":\"Retry identical signed request at most twice with 1s/2s backoff within expiry; read back after ambiguous result.\"}",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MetadataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted response. Verify the returned commitments and public readback; not a transaction confirmation."
          },
          "400": {
            "description": "Malformed/invalid input; metadata validation does not consume its nonce."
          },
          "401": {
            "description": "Invalid signature/challenge/scope/expiry."
          },
          "403": {
            "description": "Wrong requester/worker or missing eligible Agent ID."
          },
          "409": {
            "description": "REPLAY, commitment mismatch, state conflict, or HEALTH_ACK_REQUIRED."
          },
          "429": {
            "description": "Rate limited. Honor Retry-After."
          },
          "503": {
            "description": "Unavailable dependency; inspect outcome/readback before retry."
          }
        }
      }
    },
    "/api/marketplace/tasks/{id}/upload": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      ],
      "post": {
        "description": "\"Single-use nonce; get fresh challenge before retry. Check existing receipt first.\"",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
